PORT=3001
CORS_ORIGIN=http://localhost:5173
SQLITE_PATH=./data/dialogs.sqlite
DIALOG_DB_PASSWORD=test-db-password-2026-notar
DIALOG_DB_SALT=test-db-salt-2026-notar
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=admin-session-secret-2026-notar

# Demo-Modus:
#   true  = kein Admin-Login, Dialog-Bearbeitungen leben nur in der jeweiligen
#           Sitzung des Nutzers, keine E-Mails, keine DiNo-Verbindung.
#           Admin-Settings werden ebenfalls nur in der Session gespeichert.
#   false = Produktivbetrieb (Admin-Login + Übermittlungswege wie konfiguriert).
DEMO_MODE=false

# Primärfarbe für PDF-Header (Hex ohne #)
PRIMARY_COLOR=1a3a5c

# Rate-Limit für Submissions pro 15min
RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Alle weiteren Laufzeit-Einstellungen werden im Admin-Bereich verwaltet:
#
#   Versand        → DiNo / E-Mail aktiv, Anhang-Auswahl (PDF/DOCX/JSON/DiNo-JSON)
#   E-Mail         → SMTP-Host/Port/User/Passwort, Absender, Notar-Empfänger,
#                    SMTP-Debug, HTML-Signatur, Mandanten-E-Mail-Vorlage
#   DiNo           → API-Key, TTL für ungelesene Einreichungen
#
# Die folgenden ENV-Variablen werden ausschließlich als Erstbefüllung
# verwendet (Fallback, wenn in der Datenbank noch nichts gespeichert ist).
# Sobald im Admin-Bereich gespeichert wurde, gelten diese Werte – die ENV-
# Einträge können dann entfernt werden.
# ---------------------------------------------------------------------------

# Versand (Fallback, sonst Admin → Versand)
# DINO_ENABLED=false
# EMAIL_ENABLED=true

# E-Mail (Fallback, sonst Admin → E-Mail)
# SMTP_HOST=mail.kemto.de
# SMTP_PORT=587
# SMTP_USER=noreply@kemto.de
# SMTP_PASS=
# SMTP_DEBUG=true
# FROM_EMAIL=noreply@kemto.de
# FROM_NAME=OpenFormulare
# NOTAR_EMAIL=noreply@kemto.de

# DiNo (Fallback, sonst Admin → DiNo)
# DINO_API_KEY=
# DINO_TTL_HOURS=72
