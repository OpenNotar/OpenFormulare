{
  "name": "openformulare-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "python3 scripts/run_yoyo.py",
    "build": "tsc && node -e \"require('fs').cpSync('src/db/seeds','dist/db/seeds',{recursive:true})\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "puppeteer": "^23.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.16",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
