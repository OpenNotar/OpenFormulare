# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/

# Versehentlich neben den .ts-Quellen abgelegte JS-Build-Artefakte.
# Bei CommonJS-Modulauflösung priorisiert Node die .js, was dazu führt,
# dass ts-node-dev seine frisch transpilierte Version nicht greift —
# Bugs sind dann schwer nachzuvollziehen.
backend/src/**/*.js
frontend/src/**/*.js

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo

# Python
*.pyc
__pycache__/

# Vite
.vite/

# Puppeteer cache
.cache/puppeteer/

# Debug dumps (local development only)
DebugDump/

# Local SQLite databases
backend/data/

# Datenbank
*.sqlite
*.sqlite-wal
*.sqlite-shm
